{
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,

  "dry_run": true,
  "dry_run_wallet": 1000,

  "timeframe": "5m",
  "process_throttle_secs": 5,

  "exchange": {
    "name": "binance",
    "demo_trading": false,
    "key": "REPLACE_WITH_BINANCE_API_KEY",
    "secret": "REPLACE_WITH_BINANCE_API_SECRET",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "spot",
        "fetchCurrencies": false
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "spot",
        "fetchCurrencies": false
      }
    },
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT"
    ],
    "pair_blacklist": [
      "BNB/USDT"
    ]
  },

  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],

  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },

  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },

  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },

  "stoploss": -0.02,
  "trailing_stop": true,
  "trailing_stop_positive": 0.01,
  "trailing_stop_positive_offset": 0.02,
  "trailing_only_offset_is_reached": true,

  "telegram": {
    "enabled": true,
    "token": "REPLACE_WITH_TELEGRAM_BOT_TOKEN",
    "chat_id": "REPLACE_WITH_TELEGRAM_CHAT_ID"
  },

  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": true,
    "jwt_secret_key": "cf74e892b15d4a13a89e4c5678fa012bcf3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f",
    "ws_token": "92a1b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2",
    "username": "admin",
    "password": "admin@123"
  },

  "bot_name": "triple-guard",
  "initial_state": "running",
  "force_entry_enable": false,

  "internals": {
    "process_throttle_secs": 5
  }
}
