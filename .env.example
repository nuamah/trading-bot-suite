# Copy to ".env" and fill in values.
# Never commit your real ".env".

# -------- Mode control (ONLY change these to switch modes) --------
# demo     = dry-run (paper)
# testnet  = binance spot sandbox (testnet.binance.vision)
# live     = live spot
CONFIG_PROFILE=demo

# These variables drive Freqtrade via docker-compose environment overrides.
BINANCE_ACTIVE_API_KEY=REPLACE_ME
BINANCE_ACTIVE_API_SECRET=REPLACE_ME
BINANCE_SANDBOX=false
FREQTRADE_DRY_RUN=true

# -------- Key vault (store all 3 keysets here) --------
BINANCE_LIVE_API_KEY=REPLACE_ME
BINANCE_LIVE_API_SECRET=REPLACE_ME

BINANCE_DEMO_API_KEY=REPLACE_ME
BINANCE_DEMO_API_SECRET=REPLACE_ME

BINANCE_TESTNET_API_KEY=REPLACE_ME
BINANCE_TESTNET_API_SECRET=REPLACE_ME

# -------- Telegram --------
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# -------- API server (strongly recommended to change) --------
# Use long random strings for tokens/keys.
FREQTRADE_API_USERNAME=admin
FREQTRADE_API_PASSWORD=CHANGE_ME
FREQTRADE_API_JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
FREQTRADE_API_WS_TOKEN=CHANGE_ME_LONG_RANDOM_STRING

# Optional: set timezone inside container logs
TZ=UTC
